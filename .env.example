# Copy to .env for local runs of the server. On Render, set these in the
# dashboard instead (render.yaml leaves ADMIN_ALLOWED_IPS for you to fill in).

# Your laptop's PUBLIC IP - what ipify.com / whatismyip.com report, not the
# 192.168.x.x address from ipconfig. Comma-separate for multiple addresses.
ADMIN_ALLOWED_IPS=203.0.113.7

# all   = whole site is hidden from unrecognised IPs (default)
# admin = only /admin is hidden, storefront stays public
IP_GATE_SCOPE=all

# Local-dev only escape hatch. Refused when NODE_ENV=production.
IP_GATE_DISABLED=false
